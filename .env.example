# OAuth de cliente web: configuración exclusiva del backend.
GOOGLE_AUTH_MODE=oauth
GOOGLE_OAUTH_CLIENT_ID=REEMPLAZAR.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=REEMPLAZAR_CON_SECRETO_NUEVO
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/conexion/google/callback
# Generar una vez 32 bytes aleatorios en base64; conservar la clave entre reinicios.
GOOGLE_TOKEN_ENCRYPTION_KEY=REEMPLAZAR_CON_BASE64_DE_32_BYTES
GOOGLE_SHEETS_WRITES_ENABLED=false
EAS_GO_SHEETS_REFERENCE_PATH=./data/sheets-reference.json
# Producción: APP_PUBLIC_ORIGIN=https://su-dominio.example
# Google Cloud sin claves descargadas: GOOGLE_AUTH_MODE=adc, sin GOOGLE_APPLICATION_CREDENTIALS.
